# ==============================================================================
# LUMORA COSMIC PORTFOLIO — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Engine (Powers Ask Nova AI in the Top-Right HUD)
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model
# Options: gemini-1.5-flash (fast & recommended), gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Optional: Server HTTP Port (default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 2. Contact Transmission Engine (Neptune Subspace Nexus)
# ------------------------------------------------------------------------------
# All incoming transmissions are AUTOMATICALLY saved to `data/messages.json`.
# To also forward transmissions directly to your real email inbox, choose ONE
# of the options below:

# Receiver Email (where you want to receive portfolio inquiries)
CONTACT_RECEIVER_EMAIL=tanishkasahuwork191@gmail.com

# OPTION A: Free Gmail SMTP via Nodemailer (Recommended & Instant)
# 1. Go to your Google Account: https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already active
# 3. Under 2-Step Verification, scroll down to "App passwords"
# 4. Generate a new App Password (name it "Lumora Portfolio")
# 5. Paste your Gmail address and the 16-character App Password below:
GMAIL_USER=tanishkasahuwork191@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password_here

# OPTION B: Resend REST API (Free 3,000 emails/month, no app password needed)
# 1. Create a free account at https://resend.com
# 2. Generate an API Key
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=onboarding@resend.dev

# OPTION C: Custom SMTP Server
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false

# OPTION D: Instant Discord / Slack Webhook (Receive instant pings on your phone)
# CONTACT_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url
